<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>inspector</groupId>
    <artifactId>dsh-inspector</artifactId>
    <version>0.1.0</version>

    <properties>
        <java.version>26</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!--
            Health and readiness, on the same port and the same boundary as everything else.
            What it exposes is restricted in application.yml, and the restriction is a privacy
            control (§4.1), not tidiness: /actuator/env and /actuator/configprops print
            inspector.corpus, which carries the username.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            Generated OpenAPI document over the five endpoints. The version line matters: Boot 3
            needs springdoc 2.x and cannot run springdoc 3, and vice versa. springdoc.org's own
            page for the current release (v3.1.1) lists "Spring-boot v4" among what it supports,
            and the Boot-4-only artifact names in its own dependencies (spring-boot-jackson,
            spring-boot-validation) confirm which line this is. Checked at springdoc.org rather
            than remembered from a Boot 3 project.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.4.0</version>
        </dependency>
        <dependency>
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
            <version>1.5.7-16</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Boot 4 moved MockMvc auto-configuration out of spring-boot-starter-test
            (org.springframework.boot.test.autoconfigure.web.servlet no longer exists);
            @AutoConfigureMockMvc now lives in spring-boot-webmvc-test.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Regenerates the committed fixture corpus. The generator is development tooling and
                 lives under src/test so it stays out of the deployable jar, which means the java
                 goal has to be told to look at the test classpath — without classpathScope the
                 class simply is not there and exec:java fails with a ClassNotFoundException that
                 reads like a broken mainClass. Run it from backend/ with: mvn -q test-compile
                 exec:java (the generator's own javadoc says what it writes and where). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>inspector.fixturegen.FixtureGenerator</mainClass>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
