# --- backend (Spring Boot / Maven) ---
target/
*.class
# local config that may point at a real home directory
application-local.yml
application-local.properties

# --- frontend (Angular / npm) ---
node_modules/
dist/
.angular/

# --- local database (regenerated by an index run; never committed) ---
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# --- editor / os ---
.idea/
.vscode/
*.iml
.DS_Store

# NOTE: the synthetic fixture corpus under backend/fixtures/sessions/ is
# committed ON PURPOSE. It is what makes `./run.sh` show a populated dashboard on a fresh
# clone, and it carries the regression cases in docs/DESIGN.md §11 (both schema
# conventions, the mention-without-mutation case, the measured false positive, the
# documentation-contamination session). It is produced by the Java generator in backend/,
# which is also committed, so provenance is reproducible and fixtures go through the same
# ingest path as a real ~/.dsh corpus.

# --- LOCAL ONLY, NEVER COMMIT -------------------------------------------
# A frozen copy of real session logs, used as the integration corpus. It contains
# real conversation content, absolute paths, usernames and project names. Nothing
# under here may ever be committed, referenced from committed code, or printed.
corpus/

# machine-local operating constraints for agents working in this checkout.
# References paths on a personal machine, so it is not part of the published repo.
AGENTS.md

# agent-facing implementation plans: working documents, not reviewer artifacts
docs/superpowers/

# review board: agent-facing task files and their working logs, same category as
# docs/superpowers/ above — a queue of known defects is a working document, not a
# reviewer artifact. Commit it deliberately if the loop itself becomes the thing worth
# showing; until then it stays local.
docs/tasks/
