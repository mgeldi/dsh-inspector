# build output
target/
dist/
node_modules/

# local database (regenerated by indexing; never committed)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# tooling / editor
.idea/
.vscode/
*.iml
.DS_Store

# NOTE: the synthetic fixture corpus under
# backend/src/main/resources/fixtures/ IS committed on purpose — it is what makes
# `./run.sh` show a populated dashboard on a fresh clone. It is generated by
# tools/generate-fixtures.mjs, which is also committed, so provenance is reproducible.

# local config that may point at a real home directory
application-local.yml
application-local.properties
